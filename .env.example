# Postgres connection string. Vercel sets this for you when you attach a
# Neon/Postgres database from the Storage tab. Without it the site runs
# read-only off seed/jobs.json.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Shared secret the scheduled agent uses to write to /api/*.
# Generate one with:  openssl rand -hex 24
AGENT_TOKEN=

# Password for opening the site in a browser. Leave unset for no gate
# (only sensible if you also turn on Vercel Deployment Protection).
APP_PASSWORD=
