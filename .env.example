# Supabase project URL and secret key (sb_secret_...). Vercel sets both for
# you when you connect Supabase from the Storage tab. Locally, `supabase start`
# prints them. The secret key bypasses RLS: server-side only, never NEXT_PUBLIC_.
# Without these the site runs read-only off seed/jobs.json.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Shared secret the scheduled agent uses to write to /api/*.
# Generate one with:  openssl rand -hex 24
AGENT_TOKEN=

# Google accounts allowed to sign in (comma-separated). Google sign-in needs the
# Google provider turned on in Supabase; see "Signing in" in the README. The
# browser also uses NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# which Vercel's Supabase integration sets.
ALLOWED_EMAILS=

# Optional password sign-in, kept as a fallback. Remove it once Google works.
# With neither ALLOWED_EMAILS nor APP_PASSWORD set, the site has no gate.
APP_PASSWORD=
